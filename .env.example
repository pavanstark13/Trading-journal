# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and replace every value marked CHANGE-ME.
# .env is git-ignored. Never commit real secrets.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ─────────────────────────────────────────────────────────────────────────────

ENV=production
API_BASE_URL=https://api.example.com
FRONTEND_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
ENABLE_DOCS=false
LOG_LEVEL=INFO

# ── secrets ──────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE-ME
MASTER_ENCRYPTION_KEY=CHANGE-ME
POSTGRES_PASSWORD=CHANGE-ME
REDIS_PASSWORD=CHANGE-ME

# ── auth ─────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
REQUIRE_2FA_FOR_SUPERADMIN=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_THRESHOLD=10

# ── EA transport ─────────────────────────────────────────────────────────────
# Must match InpNamespace in both Expert Advisors, or event ids will differ and
# idempotency breaks silently.
EVENT_ID_NAMESPACE=tradebridge.example.com
EA_TIMESTAMP_SKEW_SEC=120
EA_NONCE_TTL_SEC=300
EA_EVENT_BATCH_MAX=100
MEMBER_POLL_WAIT_SEC=25
MEMBER_HEARTBEAT_TIMEOUT_SEC=90
MASTER_HEARTBEAT_TIMEOUT_SEC=120

# ── trading mode ─────────────────────────────────────────────────────────────
# Mode a fresh installation seeds. Set PAPER if you want simulated fills first.
# Either way, copying stays OFF per member until you enable each one.
DEFAULT_MODE=LIVE

# ── copy engine ──────────────────────────────────────────────────────────────
DEFAULT_MAX_SIGNAL_AGE_SEC=60
COPY_LEASE_TTL_SEC=45

# ── telegram ─────────────────────────────────────────────────────────────────
# The bot token is NOT set here. It is stored encrypted in the database and
# configured through the dashboard, so it can be rotated without a redeploy.
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_MAX_RETRIES=6
TELEGRAM_RATE_LIMIT_PER_SEC=20

# ── observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_ENABLED=true
