# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and replace every value marked CHANGE-ME. .env is git-ignored.
#
# On a hosting platform, set these in the project's own environment settings
# rather than in a file. Vercel's import screen reads this file and offers the
# names below -- so only fill in the first section there.
#
# Generate a secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ...or on an iPad, use Settings -> Passwords -> the key icon.
# ─────────────────────────────────────────────────────────────────────────────

# ── required, on the API project ─────────────────────────────────────────────
# Signs login sessions. Changing it logs everyone out.
JWT_SECRET=CHANGE-ME
# Encrypts stored credentials. Changing it makes existing ones unreadable, so
# treat this as permanent once there is real data behind it.
MASTER_ENCRYPTION_KEY=CHANGE-ME
# The scheduler sends this back as a bearer token. Without it the scheduler
# endpoints return 404 rather than running -- an open one is a free way for
# anyone to drive the database.
CRON_SECRET=CHANGE-ME
# Reads MetaTrader history for accounts with no Expert Advisor of their own.
# Leave empty to switch that feature off entirely.
METAAPI_TOKEN=
# Where the browser loads the site from. The API refuses requests from anywhere
# else, so this is the CORS allow-list, not decoration.
FRONTEND_ORIGIN=https://app.example.com

# ── required, on the web project ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# ── do NOT set these on Vercel ───────────────────────────────────────────────
# The storage add-ons write POSTGRES_URL and KV_URL themselves and the
# application reads them, correcting the driver and SSL parameters on the way.
# Setting DATABASE_URL by hand is how you end up on the unpooled endpoint, which
# works in testing and collapses under load. SERVERLESS, ENV and ENABLE_DOCS are
# all inferred from VERCEL and VERCEL_ENV.
#
# DATABASE_URL=postgresql+asyncpg://app:CHANGE-ME@localhost:5432/app
# REDIS_URL=redis://localhost:6379/0
# SERVERLESS=true
# ENV=production
# ENABLE_DOCS=false

# ── self-hosted only (infra/docker-compose.yml) ──────────────────────────────
POSTGRES_PASSWORD=CHANGE-ME
REDIS_PASSWORD=CHANGE-ME
API_BASE_URL=https://api.example.com
LOG_LEVEL=INFO

# ── optional tuning; every one of these has a sensible default ───────────────
# ACCESS_TOKEN_TTL_MIN=15
# REFRESH_TOKEN_TTL_DAYS=30
# LOGIN_MAX_ATTEMPTS=5
# How often a cloud-read account is checked for new trades.
# PROVIDER_POLL_INTERVAL_SEC=300
# How long one sync may run before saving its place. Keep under the platform's
# function timeout.
# PROVIDER_SYNC_BUDGET_SEC=40
# SENTRY_DSN=
